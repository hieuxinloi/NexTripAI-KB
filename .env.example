# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# GraphRAG V2 uses an isolated Neo4j container and volume.
NEO4J_V2_URI=bolt://localhost:7688
NEO4J_V2_USER=neo4j
NEO4J_V2_PASSWORD=change-me
NEO4J_V2_DATABASE=neo4j

# GraphRAG V3 uses another isolated Neo4j container and volume.
NEO4J_V3_URI=bolt://localhost:7689
NEO4J_V3_USER=neo4j
NEO4J_V3_PASSWORD=change-me
NEO4J_V3_DATABASE=neo4j

# GraphRAG V4: ontology-guided evidence-aware graph.
NEO4J_V4_URI=bolt://localhost:7690
NEO4J_V4_USER=neo4j
NEO4J_V4_PASSWORD=change-me
NEO4J_V4_DATABASE=neo4j

# GraphRAG V5: typed targets and grounded geographic hierarchy.
NEO4J_V5_URI=bolt://localhost:7691
NEO4J_V5_USER=neo4j
NEO4J_V5_PASSWORD=change-me
NEO4J_V5_DATABASE=neo4j

# Gemini auth
# Option 1: Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=

# Option 2: Gemini API on Vertex AI with Application Default Credentials (ADC).
# For local service account JSON, set GOOGLE_APPLICATION_CREDENTIALS to the key path.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Protects the mutating /api/kb/v4/observations endpoint. Cloud Run should also
# keep the entire KB service private and grant roles/run.invoker only to BE.
KB_ADMIN_API_KEY=
