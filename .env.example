# Neo4j Knowledge Base versions
# Only versions with all four variables are advertised to BE and the UI.
# NEO4J_URI/USER/PASSWORD/DATABASE remain supported as legacy V1 aliases.
NEO4J_V1_URI=bolt://localhost:7687
NEO4J_V1_USER=neo4j
NEO4J_V1_PASSWORD=change-me
NEO4J_V1_DATABASE=neo4j

# GraphRAG V2 uses an isolated Neo4j container and volume.
NEO4J_V2_URI=bolt://localhost:7688
NEO4J_V2_USER=neo4j
NEO4J_V2_PASSWORD=change-me
NEO4J_V2_DATABASE=neo4j

# GraphRAG V3 uses another isolated Neo4j container and volume.
NEO4J_V3_URI=bolt://localhost:7689
NEO4J_V3_USER=neo4j
NEO4J_V3_PASSWORD=change-me
NEO4J_V3_DATABASE=neo4j

# GraphRAG V4: ontology-guided evidence-aware graph.
NEO4J_V4_URI=bolt://localhost:7690
NEO4J_V4_USER=neo4j
NEO4J_V4_PASSWORD=change-me
NEO4J_V4_DATABASE=neo4j

# GraphRAG V5: typed targets and grounded geographic hierarchy.
NEO4J_V5_URI=bolt://localhost:7691
NEO4J_V5_USER=neo4j
NEO4J_V5_PASSWORD=change-me
NEO4J_V5_DATABASE=neo4j

# GraphRAG V8 uses its own database and never falls back to V5. The local
# Compose service binds Browser to 7479 and Bolt to 7692.
NEO4J_V8_URI=bolt://localhost:7692
NEO4J_V8_USER=neo4j
NEO4J_V8_PASSWORD=change-me
NEO4J_V8_DATABASE=neo4j
ACTIVE_KB_VERSION=v8

# Neo4j driver pool policy. These settings are client-side only and do not
# alter the Neo4j instance, graph data, schema, relationships, or indexes.
NEO4J_CONNECTION_TIMEOUT=5
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=5
NEO4J_LIVENESS_CHECK_TIMEOUT=5
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_MAX_TRANSACTION_RETRY_TIME=10

# Host-only Docker Compose bind source. deploy/traffic/compose*.yaml keeps the
# repository data directory by default; set an absolute path such as
# F:\nextrip-runtime\data in deploy/traffic/.env to keep runtime artifacts off C:.
NEXTRIP_DATA_ROOT=../../data

# V8 operational observations are appended by a separate, fail-closed Airflow
# DAG. Prefer the atomic pointer; the direct dataset remains a legacy fallback
# for services that have not yet moved to pointer resolution.
NEXTRIP_NEO4J_V8_OBSERVATIONS_ENABLED=false
NEXTRIP_NEO4J_V8_OBSERVATIONS_SCHEDULE="*/15 * * * *"
NEXTRIP_CANONICAL_DATASET_POINTER=data/canonical/active-dataset-pointer.json
NEXTRIP_CANONICAL_DATASET=data/canonical/datasets/dataset=<canonical-dataset-id>/canonical-active-dataset.json
NEXTRIP_NEO4J_V8_OBSERVATION_RUN_ROOT=data/neo4j/v8/observation_runs
NEXTRIP_NEO4J_V8_HOTEL_PRICE_PREVIOUS_DAYS=1

# Airflow data ingestion is fail-closed. Enable each DAG only after the shared
# data volume and canonical pointer have been configured. Accepted dynamic
# observations are immutable JSON; data/current is only their latest projection.
NEXTRIP_ACCEPTED_OBSERVATION_ROOT=data/observations
NEXTRIP_HOTEL_PRICES_AIRFLOW_ENABLED=false
NEXTRIP_GOOGLE_MAPS_AIRFLOW_ENABLED=false
NEXTRIP_GOOGLE_MAPS_TRUSTED_SCHEDULED=false
NEXTRIP_GOOGLE_MAPS_SCHEDULE="0 2 * * 1"
NEXTRIP_GOOGLE_MAPS_POOL=google_maps_web
NEXTRIP_MAPS_WEEKLY_LIMIT=10000

# Gemini Developer API authentication from Google AI Studio.
GOOGLE_API_KEY=

# Gemini models
GEMINI_PLANNER_MODEL=gemini-flash-latest
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_ATTEMPTS=1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Protects the mutating /api/kb/v4/observations endpoint. Cloud Run should also
# keep the entire KB service private and grant roles/run.invoker only to BE.
KB_ADMIN_API_KEY=

# Hybrid traffic service. Valhalla is the free-flow baseline/fallback; HERE is
# the traffic-aware provider for motorized routes. Keep both service API keys
# in runtime secrets, never in committed config or Airflow DAG source.
VALHALLA_ENABLED=true
VALHALLA_URL=http://127.0.0.1:8002
HERE_ENABLED=true
HERE_API_KEY=
HERE_ROUTES_URL=https://router.hereapi.com/v8/routes
TRAFFIC_API_KEY=
TRAFFIC_ROUTE_TTL_SECONDS=600
TRAFFIC_MATRIX_TTL_SECONDS=600
TRAFFIC_FREE_FLOW_TTL_SECONDS=86400
TRAFFIC_DEPARTURE_BUCKET_MINUTES=5
TRAFFIC_MAX_MATRIX_CELLS=25
TRAFFIC_STALE_IF_ERROR_SECONDS=3600
TRAFFIC_CIRCUIT_FAILURE_THRESHOLD=3
TRAFFIC_CIRCUIT_COOLDOWN_SECONDS=60
NEXTRIP_TRAFFIC_AIRFLOW_ENABLED=false

# Current Data facade consumed by the external itinerary model. Static place
# truth comes only from NEXTRIP_CANONICAL_DATASET; hotel observations remain
# append-only operational inputs. Keep this API key separate from
# TRAFFIC_API_KEY so callers never receive the internal traffic credential.
CURRENT_DATA_API_KEY=
CURRENT_DATA_TRAFFIC_API_URL=http://127.0.0.1:8010
CURRENT_DATA_TRAFFIC_TIMEOUT_SECONDS=20

# Off by default. When enabled, a hotel request with refresh_if_missing=true
# may run one audited Trivago MCP stay crawl for exactly one hotel. The request
# may check later dates only after trusted unavailability (lookahead max 14).
CURRENT_DATA_TRIVAGO_REFRESH_ENABLED=false
