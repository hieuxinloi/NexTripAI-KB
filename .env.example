# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Gemini auth
# Option 1: Gemini Developer API key from Google AI Studio.
GOOGLE_API_KEY=

# Option 2: Gemini API on Vertex AI with Application Default Credentials (ADC).
# For local service account JSON, set GOOGLE_APPLICATION_CREDENTIALS to the key path.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1536

# Retrieval
RAG_TOP_K=8
RAG_TEMPERATURE=0.2
LOG_LEVEL=INFO
