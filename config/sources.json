{
  "version": 1,
  "sources": [
    {
      "source_id": "trivago-mcp",
      "display_name": "Official Trivago remote MCP",
      "kind": "aggregator",
      "crawl_method": "http_json",
      "entity_types": ["hotel"],
      "base_url": "https://mcp.trivago.com/mcp",
      "parser_version": "1.0.0",
      "enabled": true,
      "schedule_interval_minutes": 300,
      "requests_per_second": 1,
      "timeout_seconds": 60,
      "max_retries": 3,
      "respect_robots_txt": true,
      "secret_env_names": [],
      "cache_policy": {"enabled": true, "ttl_minutes": 30, "stale_if_error_minutes": 60},
      "retention_policy": {"storage_mode": "expiring", "raw_retention_days": 30},
      "fallback_policy": {
        "priority": 10,
        "fallback_source_ids": [],
        "fallback_on_empty": true,
        "fallback_http_statuses": [408, 429, 500, 502, 503, 504]
      }
    },
    {
      "source_id": "google-maps-web",
      "display_name": "Google Maps public place page",
      "kind": "aggregator",
      "crawl_method": "playwright",
      "entity_types": ["attraction", "cafe", "nightlife", "restaurant"],
      "base_url": "https://www.google.com/maps/search/",
      "parser_version": "1.0.0",
      "enabled": false,
      "schedule_interval_minutes": 1440,
      "requests_per_second": 1,
      "timeout_seconds": 30,
      "max_retries": 3,
      "respect_robots_txt": true,
      "secret_env_names": [],
      "cache_policy": {"enabled": true, "ttl_minutes": 1440, "stale_if_error_minutes": 1440},
      "retention_policy": {"storage_mode": "expiring", "raw_retention_days": 1},
      "fallback_policy": {
        "priority": 10,
        "fallback_source_ids": [],
        "fallback_on_empty": false,
        "fallback_http_statuses": [408, 429, 500, 502, 503, 504]
      }
    }
  ]
}
