# Runtime endpoints bind to loopback by default. Put a TLS reverse proxy in
# front before changing these addresses to 0.0.0.0.
TRAFFIC_BIND_ADDRESS=127.0.0.1
TRAFFIC_PORT=8010
CURRENT_DATA_BIND_ADDRESS=127.0.0.1
CURRENT_DATA_PORT=8020
KB_API_BIND_ADDRESS=127.0.0.1
KB_API_PORT=8011
NEXTRIP_KB_IMAGE_TAG=local
VALHALLA_BIND_ADDRESS=127.0.0.1
VALHALLA_PORT=8002

# Prepared by prepare-valhalla-data.ps1 from a checksummed local OSM PBF.
VALHALLA_DATA_DIR=./valhalla-data
VALHALLA_DATASET_VERSION=vietnam-2026-08-19
VALHALLA_SERVER_THREADS=2
VALHALLA_ENABLED=true

# Host directory mounted at the containers' data root. The default preserves
# the repository-local data directory. On Windows, keep this value unquoted so
# backslashes remain literal, for example: F:\nextrip-runtime\data
NEXTRIP_DATA_ROOT=../../data

# Required immutable serving source for the traffic API. Airflow prefers the
# integrity-checked pointer below; the direct path remains its migration
# fallback. Traffic mounts canonical read-only, while Airflow mounts the shared
# data directory read/write for raw, accepted observations, and new releases.
NEXTRIP_CANONICAL_DATASET=data/canonical/datasets/dataset=<canonical-dataset-id>/canonical-active-dataset.json
NEXTRIP_CANONICAL_DATASET_POINTER=data/canonical/active-dataset-pointer.json

# HERE remains the traffic-aware primary for drive/two_wheeler. Copy this file
# to deploy/traffic/.env and keep the populated file out of Git.
HERE_ENABLED=true
HERE_API_KEY=
HERE_ROUTES_URL=https://router.hereapi.com/v8/routes

# Required on internal route, matrix, cache and access-point endpoints.
TRAFFIC_API_KEY=replace-with-a-long-random-secret

# Internal facade used by NexTripAI-BE. Generate a different secret from the
# traffic key, then copy this exact value to NexTripAI-BE/.env.
CURRENT_DATA_API_KEY=replace-with-a-long-random-secret
CURRENT_DATA_TRAFFIC_TIMEOUT_SECONDS=20
# Enabling this permits a cache miss for one hotel/context to run the bounded
# Trivago pipeline and write append-only operational JSON under NEXTRIP_DATA_ROOT.
CURRENT_DATA_TRIVAGO_REFRESH_ENABLED=false

TRAFFIC_PROVIDER_TIMEOUT_SECONDS=20
TRAFFIC_ROUTE_TTL_SECONDS=600
TRAFFIC_MATRIX_TTL_SECONDS=600
TRAFFIC_FREE_FLOW_TTL_SECONDS=86400
TRAFFIC_DEPARTURE_BUCKET_MINUTES=5
TRAFFIC_MAX_MATRIX_CELLS=25
TRAFFIC_STALE_IF_ERROR_SECONDS=3600
TRAFFIC_CIRCUIT_FAILURE_THRESHOLD=3
TRAFFIC_CIRCUIT_COOLDOWN_SECONDS=60

# Airflow is off until explicitly enabled. Prewarm is a second cost-control
# gate because it generates HERE route requests on every scheduled run.
NEXTRIP_TRAFFIC_AIRFLOW_ENABLED=false
NEXTRIP_TRAFFIC_PREWARM_ENABLED=false
NEXTRIP_TRAFFIC_MAINTENANCE_SCHEDULE=17 * * * *
NEXTRIP_TRAFFIC_PREWARM_SCHEDULE=*/10 * * * *

# Data DAGs are fail-closed and disabled until explicitly enabled. Trivago
# writes accepted price/availability JSON every five hours. Google Maps runs
# weekly and uses deterministic PASS/QUARANTINE decisions with no review queue.
NEXTRIP_ACCEPTED_OBSERVATION_ROOT=data/observations
NEXTRIP_HOTEL_PRICES_AIRFLOW_ENABLED=false
NEXTRIP_GOOGLE_MAPS_AIRFLOW_ENABLED=false
NEXTRIP_GOOGLE_MAPS_TRUSTED_SCHEDULED=false
NEXTRIP_GOOGLE_MAPS_SCHEDULE="0 2 * * 1"
NEXTRIP_GOOGLE_MAPS_POOL=google_maps_web
NEXTRIP_GOOGLE_MAPS_POOL_SLOTS=1
NEXTRIP_CURRENT_DATA_POOL=current_data_snapshot
NEXTRIP_CURRENT_DATA_POOL_SLOTS=1
NEXTRIP_CANONICAL_ROLLOUT_AIRFLOW_ENABLED=false
NEXTRIP_CANONICAL_ROLLOUT_POOL=canonical_release_rollout
NEXTRIP_CANONICAL_ROLLOUT_POOL_SLOTS=1
NEXTRIP_CANONICAL_ROLLOUT_RUN_ROOT=data/runs/canonical_rollout
NEXTRIP_NEO4J_V8_IMPORT_BATCH_SIZE=500
NEXTRIP_MAPS_WEEKLY_LIMIT=10000
NEXTRIP_MAPS_MAX_NO_UPDATE_RATIO=0.20

# Gemini semantic embeddings run after a canonical release is active. Keep the
# flag disabled until GOOGLE_API_KEY or GEMINI_API_KEY is configured.
NEXTRIP_V8_EMBEDDING_ENABLED=false
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NEXTRIP_V8_EMBEDDING_DIMENSION=1536
NEXTRIP_V8_EMBEDDING_BATCH_SIZE=16
NEXTRIP_V8_EMBEDDING_REQUEST_DELAY=2
NEXTRIP_V8_EMBEDDING_MAX_RETRIES=5
NEXTRIP_V8_EMBEDDING_CACHE_ROOT=data/cache/v8_embeddings
NEXTRIP_V8_EMBEDDING_RUN_ROOT=data/neo4j/v8/embedding_runs

# Enable only after the matching canonical release is active in Neo4j.
NEXTRIP_NEO4J_V8_OBSERVATIONS_ENABLED=false
NEXTRIP_NEO4J_V8_OBSERVATIONS_SCHEDULE="*/15 * * * *"
NEO4J_V8_URI=
NEO4J_V8_USER=neo4j
NEO4J_V8_PASSWORD=
NEO4J_V8_DATABASE=neo4j

# Required only when compose.airflow.yaml is enabled. Generate unique values;
# never deploy the placeholders below.
AIRFLOW_UID=50000
AIRFLOW_BIND_ADDRESS=127.0.0.1
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=replace-with-a-long-random-password
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
AIRFLOW_FERNET_KEY=replace-with-a-valid-fernet-key
AIRFLOW_API_JWT_SECRET=replace-with-a-long-random-secret
